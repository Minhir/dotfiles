{
  "$schema": "vscode://schemas/settings/user",
  "cSpell.language": "en,ru",
  "diffEditor.renderSideBySide": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.renderWhitespace": "trailing",
  "editor.unicodeHighlight.allowedLocales": {
    "ru": true
  },
  "git.blame.editorDecoration.enabled": true,
  "git.blame.editorDecoration.template": "${authorName}, ${authorDateAgo} - ${subject}",
  "git.suggestSmartCommit": false,
  "json.schemaDownload.trustedDomains": {
    "https://biomejs.dev": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://opencode.ai": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://www.schemastore.org/": true
  },
  "Lua.format.defaultConfig": {
    "indent_size": "2",
    "indent_style": "space"
  },
  "scm.defaultViewMode": "tree",
  "terminal.integrated.defaultProfile.linux": "Nushell",
  "terminal.integrated.profiles.linux": {
    "Nushell": {
      "path": "${env:SHELL}",
      "args": ["-i", "-c", "exec nu"]
    }
  },
  "terminal.integrated.defaultProfile.osx": "Nushell",
  "terminal.integrated.profiles.osx": {
    "Nushell": {
      "path": "${env:SHELL}",
      "args": ["-i", "-c", "exec nu"]
    }
  },
  "terminal.integrated.scrollback": 10000,
  "window.titleBarStyle": "custom",
  "window.zoomLevel": 1,
  "workbench.colorCustomizations": {
    "editorWhitespace.foreground": "#F00"
  },
  "workbench.colorTheme": "Dark Modern"
}
